{
    "name": "salehhub/laravel-remote-logger",
    "description": "Send Laravel logs to a centralized remote logging server",
    "keywords": ["laravel", "logging", "remote", "centralized"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Saleh",
            "email": "saleh@example.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/support": "^10.0|^11.0|^12.65|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.65|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.65|^13.0",
        "monolog/monolog": "^3.10"
    },
    "require-dev": {
        "orchestra/testbench": "^11.1",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "RemoteLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RemoteLogger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": [
            "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-clover=build/coverage.xml --coverage-text",
            "@php tests/check-coverage.php build/coverage.xml 100"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "RemoteLogger\\RemoteLoggerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
